\definecolor{jhanaInk}{HTML}{212B36}
\definecolor{jhanaGreen}{HTML}{00AB55}
\definecolor{jhanaGreenDark}{HTML}{007B55}
\definecolor{jhanaGreenDarker}{HTML}{005249}
\definecolor{jhanaGreenLight}{HTML}{C8FACD}
\definecolor{jhanaDim}{HTML}{637381}
\definecolor{jhanaRow}{HTML}{F4F6F8}
\definecolor{jhanaCream}{HTML}{FAF4ED}
\definecolor{jhanaAmber}{HTML}{B45309}
\definecolor{jhanaWarning}{HTML}{FFF4DE}
\definecolor{navy}{HTML}{212B36}
\definecolor{teal}{HTML}{00AB55}
\definecolor{accent}{HTML}{007B55}
\definecolor{row1}{HTML}{F4F6F8}
\definecolor{row2}{HTML}{FFFFFF}
\definecolor{hdr}{HTML}{212B36}
\definecolor{totbg}{HTML}{C8FACD}
\definecolor{resbg}{HTML}{E8F7EE}
