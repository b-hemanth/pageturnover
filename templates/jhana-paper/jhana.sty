\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jhana}[2026/08/26 jhana long-form document system]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{jhana}{This package requires XeLaTeX}{Select XeLaTeX as the compiler.}
\fi

\RequirePackage[a4paper,margin=0.82in,top=0.72in,bottom=0.78in]{geometry}
\RequirePackage{fontspec}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{graphicx}
\RequirePackage[table,dvipsnames]{xcolor}
\RequirePackage{enumitem}
\RequirePackage{setspace}
\RequirePackage{adjustbox}
\RequirePackage{titlesec}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
\RequirePackage{calc}
\RequirePackage{colortbl}
\RequirePackage{fancyhdr}
\RequirePackage[round,authoryear]{natbib}
\RequirePackage{hyperref}

% Typography. Prefer the locally installed jhana faces; TeX Gyre remains a
% deliberate fallback on machines where the brand fonts are unavailable.
% The variable font files are bundled in assets/ for newer engines and editors.
\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
\IfFontExistsTF{Work Sans}{%
  \setmainfont[
    BoldFont={Work Sans},BoldFeatures={FakeBold=1.45},
    ItalicFont={Work Sans},ItalicFeatures={FakeSlant=0.18},
    BoldItalicFont={Work Sans},BoldItalicFeatures={FakeBold=1.35,FakeSlant=0.18}
  ]{Work Sans}%
}{\setmainfont{TeX Gyre Heros}}
\IfFontExistsTF{Lora}{%
  \newfontfamily\jhanaserif[
    BoldFont={Lora},BoldFeatures={FakeBold=1.45},
    ItalicFont={Lora},ItalicFeatures={FakeSlant=0.18},
    BoldItalicFont={Lora},BoldItalicFeatures={FakeBold=1.35,FakeSlant=0.18}
  ]{Lora}%
}{\newfontfamily\jhanaserif{TeX Gyre Pagella}}
\IfFontExistsTF{Georgia}{\newfontfamily\rupeefont{Georgia}}{\newfontfamily\rupeefont{DejaVu Sans}}
\newcommand{\rupee}{\text{\rupeefont ₹}}

